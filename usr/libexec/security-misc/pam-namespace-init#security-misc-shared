## AI-Assisted

## Creates X11-related tmp directories so XWayland and apps that use it work
## correctly.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

polydir="${1:-}"

## style-ok: R-170 - "/tmp" must be where these dirs are located.
if [ "${polydir}" = "/tmp" ]; then
   for x11_dirname in '.X11-unix' '.ICE-unix' '.XIM-unix' '.font-unix'; do
      install --directory --mode=1777 -- "${polydir}/${x11_dirname}"
   done
fi

exit 0
